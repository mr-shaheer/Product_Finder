# --- LLM (pick ONE provider) ---------------------------------------------
# Providers: gemini, openai, anthropic, groq, openrouter, mistral, deepseek, together, custom
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=Put Your Provider Key Here
# Only for LLM_PROVIDER=custom (OpenAI-compatible server, https only):
# LLM_BASE_URL=https://your-server.example.com/v1

# Old setting still works for the CLI if LLM_API_KEY is empty:
# GEMINI_API_KEY=Put Your Gemini Key Here

# --- Product search ---
SERPAPI_KEY=Put Your SerpApi Key Here

# --- Optional: OpenAI tracing only ---
OPENAI_API_KEY=Put Your Openai Key Here